[Unit]
Description=Telethon selfbot + helper bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=selfbot
WorkingDirectory=/opt/telethon-selfbot
EnvironmentFile=/opt/telethon-selfbot/.env
ExecStart=/opt/telethon-selfbot/.venv/bin/python main.py
Restart=always
RestartSec=10
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/telethon-selfbot/data /opt/telethon-selfbot/logs

[Install]
WantedBy=multi-user.target
